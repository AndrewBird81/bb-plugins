{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "react": ["node_modules/@types/react/index.d.ts"],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"],
      "zod": ["node_modules/zod/index.d.ts"]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src"]
}
